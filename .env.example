# Supabase project URL and public publishable key (or legacy anon key). Never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing historical tables by default. Set reconstruction only for a NEW yi_* database.
NEXT_PUBLIC_DATABASE_MODE=legacy

# Server only: required for employee invitations. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server only: optional CRM assistant; never NEXT_PUBLIC_.
# Assistant IA gratuit (Groq par défaut) : clé gratuite sur https://console.groq.com
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Facultatif : autre fournisseur compatible OpenAI (Chat Completions)
# AI_BASE_URL=https://api.groq.com/openai/v1
